# Home Assistant Configuration
HA_URL=https://your.home.assistant:8123
HA_TOKEN=

# Database Settings
DB_PATH=data/ha_stats.db
PRUNE_RAW_DAYS=0  # Set to >0 (e.g. 90) if you wish to prune fine-grained raw data while keeping rollups forever

# Web Dashboard Server
HOST=0.0.0.0
PORT=8080
AUTO_AGGREGATE_INTERVAL_MINUTES=15
LOG_LEVEL=INFO